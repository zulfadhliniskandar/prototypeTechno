[req]
default_bits = 2048
prompt = no
default_md = sha256
x509_extensions = v3_req
distinguished_name = dn

[dn]
CN = SafeWatch Local Hub
O = NiuTech SafeWatch

[v3_req]
subjectAltName = DNS:localhost,IP:127.0.0.1,IP:172.20.67.193
keyUsage = digitalSignature, keyEncipherment
extendedKeyUsage = serverAuth
